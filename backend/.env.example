# Mẫu cấu hình — copy thành backend/.env rồi điền giá trị thật.
# backend/.env đã .gitignore; TUYỆT ĐỐI không ghi key thật vào file .example này.

# 1 = dùng mock, không gọi model. 0 = gọi LiteLLM proxy thật.
ABES_AI_MOCK=1

# LiteLLM Proxy — endpoint OpenAI-compatible, URL kết thúc bằng /v1
ABES_AI_BASE_URL=http://10.10.50.58:30099/v1
ABES_AI_API_KEY=sk-dat-key-that-o-day
ABES_AI_MODEL=qwen3.6-27b

# Ollama — phục vụ embedding bge-m3 ở bước dựng index
ABES_OLLAMA_URL=http://192.168.24.237:11434
ABES_AI_EMBED_MODEL=bge-m3
